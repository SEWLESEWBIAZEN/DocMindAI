# =============================================================================
# DocuMind AI - local development environment
#
#   cp .env.example .env
#
# Every credential below is a DEVELOPMENT-ONLY placeholder. The backend refuses
# to start with ENVIRONMENT=production while any "change-me" value is in use.
# .env is git-ignored; never commit real credentials.
# Full reference: docs/CONFIGURATION.md
# =============================================================================

# --- Infrastructure (read by Docker Compose) --------------------------------
POSTGRES_USER=documind
POSTGRES_PASSWORD=change-me-dev-only-postgres
POSTGRES_DB=documind

REDIS_PASSWORD=change-me-dev-only-redis

MINIO_ROOT_USER=documind-minio
MINIO_ROOT_PASSWORD=change-me-dev-only-minio

# Host ports. Compose binds all of them to 127.0.0.1 only.
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=5173

# Mailpit catches all outgoing email in development (web UI on port 8025).
MAILPIT_SMTP_HOST_PORT=1025
MAILPIT_UI_HOST_PORT=8025

# --- Backend application ----------------------------------------------------
# These URLs target the published host ports and are used when the backend
# runs natively (`uv run ...`). Inside Compose the backend container gets
# equivalent URLs pointing at service hostnames instead (see docker-compose.yml).
# Keep the credentials here in sync with the infrastructure values above.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=console

DATABASE_URL=postgresql+asyncpg://documind:change-me-dev-only-postgres@localhost:5432/documind
REDIS_URL=redis://:change-me-dev-only-redis@localhost:6379/0

S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=documind-minio
S3_SECRET_ACCESS_KEY=change-me-dev-only-minio
S3_BUCKET=documind-documents

# Base URL of the web app, used in email links.
PUBLIC_APP_URL=http://localhost:5173

# Signs access tokens. Production: at least 32 random bytes, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-dev-only-jwt-secret-0123456789abcdef

# Email (Mailpit in development).
SMTP_HOST=localhost
SMTP_PORT=1025
EMAIL_FROM=DocuMind AI <no-reply@documind.local>

# Encrypts two-factor (TOTP) secrets at rest. Production: 32 random bytes,
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# (This placeholder decodes to "change-me-dev-only-mfa-key-00000" and is rejected in production.)
MFA_ENCRYPTION_KEY=Y2hhbmdlLW1lLWRldi1vbmx5LW1mYS1rZXktMDAwMDA=
# Credential vault key ring (ADR 0022): id:base64url(32 bytes), comma-separated, newest first.
# Generate: python -c "import os,base64;print('k1:'+base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Infrastructure independence (ADR 0021): hosts allowed to resolve to private addresses
# (on-premises), and a role that may CREATE DATABASE/ROLE for dedicated databases.
# INFRASTRUCTURE_ALLOWED_PRIVATE_HOSTS=postgres,minio
# DEDICATED_DATABASE_ADMIN_URL=postgresql+asyncpg://documind:change-me-dev-only-postgres@postgres:5432/postgres
CREDENTIAL_ENCRYPTION_KEYS=dev1:Y2hhbmdlLW1lLWRldi1vbmx5LWNyZWRlbnRpYWwtazE=

# Embeddings. "local" is a deterministic, offline provider for development and
# tests only (rejected in production). For real embeddings set
#   EMBEDDING_PROVIDER=openai and OPENAI_API_KEY=...
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small

# Answer generation. "local" is an offline extractive stand-in that quotes
# matching source sentences; set LLM_PROVIDER=openai (with OPENAI_API_KEY) for
# real answers. LLM_MODEL defaults to gpt-5.4-mini.
LLM_PROVIDER=local
# Claude instead: LLM_PROVIDER=anthropic, LLM_MODEL=claude-opus-5-5 and your key.
# ANTHROPIC_BASE_URL only for a compatible gateway (leave empty for Anthropic).
# Embeddings still need EMBEDDING_PROVIDER=openai: Anthropic has no embeddings API.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# ANTHROPIC_EFFORT=medium            # low | medium | high | xhigh | max
# ANTHROPIC_REFUSAL_FALLBACK=true    # set false if your gateway rejects beta headers

# Self-serve billing with Stripe (ADR 0032). Leave all empty to keep assigning
# plans with `documind-manage plan assign`. Use test-mode keys (sk_test_...) until
# you go live. Create one recurring, per-unit price for each plan and period
# (Pro $19 / $190, Business $99 / $990 per member) and point a webhook at
# https://YOUR_HOST/api/v1/billing/webhook. See docs/runbooks/billing.md.
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_PRO_MONTHLY=
# STRIPE_PRICE_PRO_ANNUAL=
# STRIPE_PRICE_BUSINESS_MONTHLY=
# STRIPE_PRICE_BUSINESS_ANNUAL=
# Where "Contact sales" (Enterprise) points.
# SALES_EMAIL=

# Google Drive connector (ADR 0035). Create an OAuth client of type "Web
# application" in Google Cloud, enable the Drive API, and register the redirect URI
# {PUBLIC_APP_URL}/api/v1/connectors/google-drive/callback. Scope: drive.readonly
# (a restricted scope: public apps need Google's verification).
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=

# Slack app (ADR 0037). Unset: Slack isn't offered. In the Slack app, set the slash
# command /documind to {PUBLIC_APP_URL}/api/v1/integrations/slack/commands, the event
# request URL to .../integrations/slack/events (bot event app_mention) and the OAuth
# redirect URL to .../integrations/slack/callback. Bot scopes: commands,
# app_mentions:read, chat:write.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=

# Voice (ADR 0011). "none": members use their browser's speech features only.
# "openai": DocuMind voice and transcription (needs OPENAI_API_KEY; audio is
# never stored). Workspace admins can still restrict voice per workspace.
SPEECH_PROVIDER=none

# Describe figures and charts in PDFs during processing, so they're searchable
# and can be read aloud. One vision-model call per figure (costs apply).
FIGURE_DESCRIPTIONS_ENABLED=false
