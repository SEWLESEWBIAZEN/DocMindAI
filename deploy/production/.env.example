# DocuMind production configuration (docs/CONFIGURATION.md has every setting).
# Copy to .env, run ./generate-secrets.sh >> .env, then fill in the rest.
# The backend refuses to start with development placeholders or insecure settings.

# --- Public address -------------------------------------------------------------
SERVER_NAME=documind.example.com
LETSENCRYPT_EMAIL=ops@example.com
# LETSENCRYPT_STAGING=true          # first dry run against Let's Encrypt staging

# --- Database: managed PostgreSQL 16 with pgvector (recommended) ----------------
DATABASE_URL=postgresql+asyncpg://documind:CHANGE_ME@db.internal.example.com:5432/documind
DATABASE_POOL_SIZE=10
# For the bundled database (profile "bundled-db") instead:
# DATABASE_URL=postgresql+asyncpg://documind:${POSTGRES_PASSWORD}@postgres:5432/documind
# POSTGRES_PASSWORD=...

# --- Object storage: S3-compatible, private bucket (ADR 0023) -------------------
S3_ENDPOINT_URL=                     # empty for AWS S3; https://... for R2, B2, Wasabi, on-prem
S3_REGION=eu-central-1
S3_BUCKET=documind-production
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_ENDPOINT_URL=              # only if browsers reach storage on another address

# --- Email ------------------------------------------------------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
SMTP_STARTTLS=true
EMAIL_FROM=DocuMind <no-reply@example.com>

# --- AI providers (platform key; workspaces may bring their own) ----------------
EMBEDDING_PROVIDER=openai
LLM_PROVIDER=openai
OPENAI_API_KEY=CHANGE_ME
SPEECH_PROVIDER=openai
FIGURE_DESCRIPTIONS_ENABLED=false

# --- Billing (ADR 0032; optional) ---------------------------------------------------
# Without these, plans are assigned with `documind-manage plan assign`.
# Setup: docs/runbooks/billing.md. Webhook: https://SERVER_NAME/api/v1/billing/webhook
# STRIPE_SECRET_KEY=sk_live_...        # or a restricted key (rk_live_...)
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_PRO_MONTHLY=price_...
# STRIPE_PRICE_PRO_ANNUAL=price_...
# STRIPE_PRICE_BUSINESS_MONTHLY=price_...
# STRIPE_PRICE_BUSINESS_ANNUAL=price_...
# SALES_EMAIL=sales@example.com

# --- Google Drive connector (ADR 0035; optional) ------------------------------------
# Redirect URI: https://SERVER_NAME/api/v1/connectors/google-drive/callback
# GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=...

# Slack app (ADR 0037). Unset: Slack isn't offered. In the Slack app, set the slash
# command /documind to {PUBLIC_APP_URL}/api/v1/integrations/slack/commands, the event
# request URL to .../integrations/slack/events (bot event app_mention) and the OAuth
# redirect URL to .../integrations/slack/callback. Bot scopes: commands,
# app_mentions:read, chat:write.
# SLACK_CLIENT_ID=...
# SLACK_CLIENT_SECRET=...
# SLACK_SIGNING_SECRET=...

# --- Malware scanning (recommended) -----------------------------------------------
MALWARE_SCANNER=none                 # clamav: also set CLAMAV_HOST / CLAMAV_PORT

# --- Infrastructure independence (ADR 0021) -------------------------------------
# DEDICATED_DATABASE_ADMIN_URL=postgresql+asyncpg://provisioner:...@dedicated.internal:5432/postgres
# DEDICATED_DATABASE_HOST=dedicated.internal.example.com
# INFRASTRUCTURE_ALLOWED_PRIVATE_HOSTS=   # on-premises only

# --- Capacity ---------------------------------------------------------------------
API_WORKERS=3                        # about one per vCPU given to the API
WORKER_CONCURRENCY=2

# --- Backups (profile "backup"; passphrase in ./secrets/backup_passphrase) --------
PGURL=postgresql://documind:CHANGE_ME@db.internal.example.com:5432/documind
BACKUP_AT=02:30
RETENTION_DAYS=14
BACKUP_OFFSITE_BUCKET=documind-backups-offsite
# Separate credentials that can write, but not delete, in the offsite bucket:
# BACKUP_S3_ENDPOINT_URL=  BACKUP_S3_REGION=  BACKUP_S3_ACCESS_KEY_ID=  BACKUP_S3_SECRET_ACCESS_KEY=

# --- Monitoring -------------------------------------------------------------------
# METRICS_TOKEN=                     # generated below; required to scrape /api/v1/metrics

# --- Generated secrets: append the output of ./generate-secrets.sh below ----------
