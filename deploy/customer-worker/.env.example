# --- DocuMind control plane (outbound HTTPS only; no inbound ports are needed) ---
DOCUMIND_URL=https://documind.example.com
DOCUMIND_WORKER_TOKEN=dmw_...            # Organization -> Infrastructure -> Register worker
WORKER_NAME=onprem-worker-1
WORKER_POLL_SECONDS=5

# --- Your data plane: the external database registered in Infrastructure ---------
# Same database and role you entered in DocuMind; tables live in the "documind" schema.
DATAPLANE_URL=postgresql+asyncpg://documind:CHANGE_ME@db.internal.example.com:5432/docs

# --- Your storage: the bucket registered in Infrastructure --------------------------
S3_ENDPOINT_URL=https://minio.internal.example.com
S3_REGION=us-east-1
S3_BUCKET=acme-documind
S3_PREFIX=documind                     # the key prefix from your infrastructure version
S3_ACCESS_KEY_ID=CHANGE_ME
S3_SECRET_ACCESS_KEY=CHANGE_ME
S3_FORCE_PATH_STYLE=true
# Azure Blob Storage instead (the container registered in Infrastructure):
# STORAGE_PROVIDER=azure_blob
# AZURE_STORAGE_ACCOUNT=acmedocs
# AZURE_STORAGE_KEY=CHANGE_ME
# AZURE_CONTAINER=documind
# AZURE_BLOB_ENDPOINT=                  # empty: https://ACCOUNT.blob.core.windows.net

# --- Embeddings: must match the model the workspace searches with ------------------
# The worker refuses to run if they differ (the heartbeat reports the expected model).
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
OPENAI_API_KEY=CHANGE_ME                # your organization's key
# OPENAI_BASE_URL=https://your-openai-compatible-gateway/v1

# --- OCR --------------------------------------------------------------------------------
OCR_ENABLED=true
OCR_LANGUAGES=eng
LOG_FORMAT=json
